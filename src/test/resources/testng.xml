<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Test Suite" verbose="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Regression Tests">
        <groups>
            <include name="regression"/>
        </groups>
        <classes>
            <class name="com.karen.tests.LoginTest"/>
            <class name="com.karen.tests.SearchTest"/>
            <class name="com.karen.tests.CartTest"/>
            <class name="com.karen.tests.CheckoutTest"/>
        </classes>
    </test>

    <test name="Smoke Tests">
        <groups>
            <include name="smoke"/>
        </groups>
        <classes>
            <class name="com.karen.tests.LoginTest"/>
            <class name="com.karen.tests.SearchTest"/>
        </classes>
    </test>
</suite>
